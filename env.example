# 데이터베이스 설정
MONGODB_URI=mongodb://localhost:27017/jokbo-breaker

# 서버 설정 (백엔드는 보통 8000번 포트)
PORT=8000
NODE_ENV=development

# Google OAuth 설정 (Google Cloud Console에서 가져온 값으로 변경하세요)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# JWT 설정 (프로덕션에서는 더 강력한 값으로 변경)
JWT_SECRET=jokbo_breaker_super_secret_key_2024_hackathon_development
JWT_EXPIRES_IN=7d

# 세션 설정
SESSION_SECRET=jokbo_breaker_session_secret_2024_hackathon

# 클라이언트 URL (프론트엔드가 실행될 주소 - 보통 3000번)
CLIENT_URL=http://localhost:3000

# AWS S3 설정
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=jokbo-breaker-images

# OpenAI ChatGPT API 설정
OPENAI_API_KEY=your_openai_api_key_here

# AI 추천 비용 제어 설정
ENABLE_AI_RECOMMENDATIONS=false          # AI 추천 활성화 (기본: false로 비용 절약)
MAX_DAILY_AI_CALLS=100                   # 일일 최대 AI API 호출 수
MAX_MENUS_FOR_AI=20                      # AI로 처리할 최대 메뉴 수
AI_THRESHOLD_SCORE=70                    # 로컬 스코어가 이 값 이하일 때만 AI 사용
